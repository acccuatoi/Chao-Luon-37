# Copy to backend/.env.local (never commit it). All values are optional.

# LLM agent. Nothing set = offline "mock" keyword parser, reported as agent: "mock" in GET /api/status.
# Option A: Anthropic
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5
# Option B: any OpenAI-compatible API (used only when ANTHROPIC_API_KEY is empty). Examples:
#   Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=<a Flash model name>
#   Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1                           LLM_MODEL=<model id from Groq console>
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1  (no key)                       LLM_MODEL=<pulled model, e.g. llama3.2>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# DEV ONLY: skip TideCloak token checks; identity comes from headers x-dev-user / x-dev-role.
# /api/status then reports mode "simulated". Keep false for the real demo.
DEV_AUTH_BYPASS=false

# Browser origin allowed to call this API directly (CORS). Not needed if the frontend uses rewrites.
FRONTEND_ORIGIN=http://localhost:3000

# Policy (the UI must read these from GET /api/status, not hard-code them)
POLICY_DAILY_CAP_USD=5000
POLICY_REQUIRED_APPROVALS=2
POLICY_WHITELIST=AWS Cloud Services,Cloudflare Inc.,Office Lease Corp,Công ty Bất động sản Hòa Bình,Stripe Payouts,Google Workspace

# Where requests and the audit log are saved (JSON). Empty = memory only.
DATA_FILE=.data/db.json
# Max POST /api/requests per user per minute
RATE_LIMIT_PER_MIN=10
# Allow POST /api/admin/reset (role approver) to wipe demo data. Keep false outside rehearsals.
DEMO_RESET_ENABLED=false
