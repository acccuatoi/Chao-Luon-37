# SentinelAgent (Cháo Lươn 37) Root Environment Configuration

# Set to false to connect frontend to the live backend API running on :3001
NEXT_PUBLIC_USE_MOCK=false

# Optional: override backend URL for Next.js rewrites (defaults to http://localhost:3001)
# BACKEND_URL=http://localhost:3001

# For backend server settings (ANTHROPIC_API_KEY, DEV_AUTH_BYPASS, POLICY_*, etc.),
# see backend/.env.example
