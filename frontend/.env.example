# Copy to frontend/.env.local (Next.js reads env from the app folder)
# Set to false to connect frontend to the live backend on http://localhost:3001
NEXT_PUBLIC_USE_MOCK=false

# Optional: customize backend URL (defaults to http://localhost:3001)
# BACKEND_URL=http://localhost:3001

# DEV ONLY, pairs with backend DEV_AUTH_BYPASS=true: use a test identity picked in the header
# (sent as x-dev-user / x-dev-role) instead of a TideCloak login. Keep false for the demo.
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
